Gizmo {
 name DRG_DirectionalDilate
 tile_color 0x3f4650ff
 label "[value direction]  [value size]"
 note_font_size 11
 help "DRG Directional Dilate v1.0.0 by David Ruiz-Galán. A directional version of Nuke's Dilate behavior. Positive Size grows light pixels; negative Size erodes. Direction can be Both, Horizontal, or Vertical."
 addUserKnob {20 DRG_DirectionalDilate l "Directional Dilate"}
 addUserKnob {7 size l Size t "Positive values dilate/grow light pixels. Negative values erode/shrink them." R -100 100}
 addUserKnob {4 direction l Direction t "Choose the axes affected by the dilation." M {Both Horizontal Vertical}}
 addUserKnob {26 divider_1 l ""}
 addUserKnob {41 channels l Channels t "Channels processed by the effect." T DRG_FilterErode.channels}
 addUserKnob {41 filter l Filter t "Filter algorithm. Box is the fastest and closest to the fast Dilate behavior." T DRG_FilterErode.filter}
 addUserKnob {41 mix l Mix t "Dissolve between the original image and the filtered result." T DRG_FilterErode.mix}
 addUserKnob {26 divider_2 l ""}
 addUserKnob {26 drg_info l "" +STARTLINE T "DRG Directional Dilate v1.0.0  •  Created by David Ruiz-Galán  •  DRG Tools"}
}
 Input {
  inputs 0
  name Input1
  xpos 0
  ypos -100
 }
 FilterErode {
  channels all
  size {{parent.direction==0?-parent.size:(parent.direction==1?-parent.size:0)} {parent.direction==0?-parent.size:(parent.direction==2?-parent.size:0)}}
  filter box
  name DRG_FilterErode
  xpos 0
  ypos 0
 }
 Output {
  name Output1
  xpos 0
  ypos 100
 }
end_group
